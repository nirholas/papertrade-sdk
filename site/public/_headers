/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'self' https://papertrade-os.pages.dev https://*.pages.dev

/
  Link: </openapi.json>; rel="service-desc"; type="application/json"
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json"
  Link: </mcp>; rel="mcp"
  Link: </docs/>; rel="service-doc"
  Link: </llms.txt>; rel="describedby"; type="text/plain"

/app.js
  Cache-Control: public, max-age=300

/.well-known/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/.well-known/api-catalog
  Content-Type: application/linkset+json

/.well-known/mcp/*
  Content-Type: application/json; charset=utf-8

/openapi.json
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8

/llms.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8

/docs/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/docs/search-index.json
  Cache-Control: public, max-age=300
